# Normalise line endings so a Windows checkout and the Linux CI agree.
#
# The CI gate runs `dart format --set-exit-if-changed`, and git's global
# `core.autocrlf` would otherwise hand Windows contributors CRLF files that the
# formatter rewrites, producing spurious diffs and a failing gate for changes
# nobody made.
* text=auto

*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary assets: never normalise, never diff.
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.jks binary
*.keystore binary
*.apk binary
*.zip binary
