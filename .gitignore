**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local secrets: API keys for the SLNews scraper API and Clerk publishable key.
# Never commit these; pass them with --dart-define or source .env.local locally.
.env
.env.local
.env.*.local
*.env.local

# Firebase client config carries a Google API key. Keep it local, inject it in
# CI from the FIREBASE_GOOGLE_SERVICES_JSON repository secret. The checked-in
# .example file is a non-secret placeholder for compiling PRs without secrets.
android/app/google-services.json

# Golden-test failure artefacts are regenerated locally on every miss.
test/golden/failures/

# Local Sentry setup wizard download (86 MB, never committed)
sentry-wizard.exe

sentry.properties

# Gradle problem reports (generated)# android/build/
android/build/

# Release artifacts are generated locally/CI and may embed client config.
*.apk
*.aab

# Machine-local orientation note (which SLNews repo is canonical). Kept on disk
# for local context; not tracked, because the READMEs already say what it says.
_ACTIVE_PROJECT.md
